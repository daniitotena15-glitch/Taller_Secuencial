Algoritmo UsoFunciones
	Definir num , seno, coseno, tangente, Rz, logaritmoNat, logaritmo10 como Real
	Escribir "Este programa te ayuda para visualizar las funciones basicas de cualquier numero que ingreses"
	Escribir "Ingresa cualqueir numero:"
	leer num
	seno = sen (num)
	coseno = cos (num)
	tangente = tan (num)
	Rz = raiz (num)
	logaritmoNat = ln(num)
	logaritmo10 = ln(num) / ln (10)
	Escribir "Del numero ingresado :", num
	Escribir "Su seno es  :", seno
	Escribir "Su coseno es  :", coseno
	Escribir "Su tangente es  :", tangente
	Escribir "Su Raiz es :", Rz
	Escribir "Su logaritmo Natural es  :", logaritmoNat
	Escribir "Su logaritmo sobre 10 es :" , logaritmo10
	
FinAlgoritmo
