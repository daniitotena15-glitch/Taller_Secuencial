Algoritmo areaAlturaDeUnCilindro
	Definir radio, altu, volumen como Real
	Escribir "Este programa te ayudara a calcular el volumen de un cilindro "
	Escribir ""
	Escribir "Por favor, para poder continuar con el proceso ingrese el radio del cilindro"
	Leer radio
	Escribir "Por favor, para poder continuar con el proceso ingrese la altura del cilindro"
	Leer altu
	volumen = PI * radio^2 * altu
	Escribir "El volumen del cilindro es : " , volumen
	
FinAlgoritmo
