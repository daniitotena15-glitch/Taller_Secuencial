Algoritmo areaPerimetroDeUnRectangulo
	Definir base, altura, area, perimetro como Real
	Escribir "Este programa te ayudara a hallar el area y el perimetro de un rectangulo"
	Escribir "Por favor, ingrese la base del rectangulo"
	Leer base
	Escribir "Por favor, ingrese la altura del rectangulo"
	Leer altura
	area = base * altura
	perimetro = 2*(base + altura)
	Escribir "El area del rectangulo es :" , area
	Escribir "El area del rectangulo es :" , perimetro
	Escribir "Gracias, fin de programa"
	
FinAlgoritmo
