Algoritmo calculeHipotenusa
	Definir cateto1 , cateto2 , hipote Como Real
	Escribir "Este programa calcula por medio de dos catetos de un triangulo su hipotenusa, por favor ingrese los datos"
	Escribir ""
	Escribir "Ingrese el primer cateto"
	Leer cateto1
	Escribir "Ingrese el segundo cateto"
	Leer cateto2
	hipote = raiz(cateto1^2 + cateto2^2)
	Escribir "La hipotenusa del triangulo es : " , hipote
	
FinAlgoritmo
