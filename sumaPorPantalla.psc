Algoritmo sumaPorPantalla
	Escribir "Este porgrama calculara la suma de dos numeros y mostrarar dicho proceso "
	Escribir ""
	Escribir "Por favor ingrese el primer numero"
	Leer num1
	Escribir "Por favor ingrese el segundo numero"
	Leer num2
	sum = num1 + num2
	Escribir "La suma de los numeros ingresados es : " , num1, " + ", num2, " es: ", sum
	
FinAlgoritmo
