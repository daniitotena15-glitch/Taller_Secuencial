Algoritmo radioDeUnCirculo
	
	Definir radio, perimetro, area como real 
	Escribir "Este programa te ayudara a calcular el area y perimetro de un circulo, apartir del valor de un radio"
	Escribir "Ingrese por favor, el valor el radio"
	Leer radio
	area = PI * (radio)^2
	perimetro = 2 * PI * radio
	Escribir "El area del circulo es : ", area
	Escribir "El perimetro del circulo es : " , perimetro
	
FinAlgoritmo
