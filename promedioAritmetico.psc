Algoritmo promedioAritmetico
	Definir num1, num2, num3, promedioA como real 
	Escribir "Este programa solicita tres numeros a los cuales se les calculara el promedio aritmetico"
	Escribir ""
	Escribir "Por favor ingrese el primer numero"
	Leer num1
	Escribir "Por favor ingrese el segundo numero"
	Leer num2
	Escribir "Por favor ingrese el tercer numero"
	Leer num3
	promedioA = (num1+num2+num3)/3
	Escribir "El promedio aritmetico de los numeros ingresados " , num1, "," num2 ," " "y" " " , num3 " " ," es :" promedioA
	
	
	
	
	
	
FinAlgoritmo
