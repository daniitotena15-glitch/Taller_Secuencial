Algoritmo conversionDeTemperatura
	Definir celsius , fht Como Real
	Escribir "Este programa realiza la conversion de temperatura de grados Celsius a Fahrenheit"
	Escribir ""
	Escribir "Por favor ingrese la temperatura que desea convertir"
	Leer celsius
	fht = (9/5) * celsius + 32
	Escribir "La temperatura en Fahrenheit es : " , fht
FinAlgoritmo
