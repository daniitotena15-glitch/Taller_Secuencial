Algoritmo numeroSiguiente
	Definir num,sigue Como Real
	Escribir "Este programa calculara y mostrara el numero siguiente del numero ingresado"
	Escribir ""
	Escribir "Por favor ingresa el numero"
	Leer num
	sigue = num+1
	Escribir "El numero ingresado es : " num, " y su numero siguiente es : " sigue
	
FinAlgoritmo
